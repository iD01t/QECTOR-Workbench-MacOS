#!/bin/bash
# AppRun — AppImage entry point for QECTOR Decoder Workbench.
#
# The PyInstaller bootloader resolves its own bundled libraries (Python, Tcl/Tk,
# numpy/scipy/matplotlib, the qector_decoder_v3 Rust core) relative to the
# executable, so no LD_LIBRARY_PATH juggling is needed here.  We only expose the
# bundled fonts to fontconfig and then hand every argument straight through, so
# `QectorWorkbench.AppImage --mcp` reaches the stdio MCP server unchanged.
set -e
HERE="$(dirname "$(readlink -f "${0}")")"
export PATH="${HERE}/usr/bin:${PATH}"
export XDG_DATA_DIRS="${HERE}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export QECTOR_OFFLINE="${QECTOR_OFFLINE:-1}"
exec "${HERE}/usr/bin/QectorWorkbench" "$@"
