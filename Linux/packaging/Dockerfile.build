# Reproducible, MAXIMUM-compatibility build image for the QECTOR Workbench AppImage.
#
# Debian 11 "bullseye" gives a glibc 2.31 baseline, so the AppImage runs on that
# release and everything newer — Ubuntu 20.04+, Debian 11+ (incl. antiX 21/22/23,
# MX Linux 21+), Linux Mint 20+, Fedora 33+, openSUSE Leap 15.3+, recent Arch,
# etc.  Building on the *oldest* supported glibc is what makes an AppImage run
# "everywhere": a binary built on a newer glibc (e.g. Kali's 2.42) would refuse
# to start on these older distros with "GLIBC_2.xx not found".
#
# Python 3.11 comes from the official python image (Debian 11 "bullseye", the
# same base antiX 21/22 and MX Linux 21 are built on), so no third-party PPA is
# needed.  Debian 11's Tk runtime (tk -> libtk8.6/libtcl8.6) is installed so the
# image's compiled _tkinter module loads at build time.
#
# Used by `./compile.sh --docker`.
FROM python:3.11-slim-bullseye

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        tk \
        build-essential binutils \
        libgl1 libglib2.0-0 \
        fonts-dejavu-core \
        wget ca-certificates file desktop-file-utils \
        libfuse2 \
        # Python packaging tools so the build can download wheels:
        python3-pkg-resources \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
CMD ["bash", "compile.sh"]
