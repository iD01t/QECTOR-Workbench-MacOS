# AppArmor confinement profile for QECTOR Decoder Workbench (v1.0.1)
#
# The application is sold as air-gapped: this profile makes that claim
# enforceable at the OS level on Ubuntu/Debian hosts that run AppArmor.
#
#   * read/exec everything under its own /usr/lib/qector-workbench install,
#   * read the per-user data dir (~/.local/share/QectorWorkbench) and the
#     standard desktop/theme/font locations the GUI needs,
#   * NETWORK: IPv4/IPv6 stream sockets and datagrams are confined to the
#     loopback range only (the in-app `qector serve` local REST API and the
#     stdio MCP server keep working; nothing can leave the machine),
#   * pipes/abstract unix sockets stay allowed (Tk, JIT and the EgressGuard
#     log machinery), but connections to a peer on a real interface are
#     denied by the addr qualifiers above.
#
# Load with, after install:
#     sudo apparmor_parser -r /etc/apparmor.d/qector-workbench
# or use aa-enforce. The Debian postinst attempts this automatically when
# apparmor_parser exists. To disable confinement: aa-disable qector-workbench.
#
# NOTE: `deny network` below overrides nothing; the addr-scoped allows are
# the actual gates. Ubuntu 20.04+ kernels (>=4.17) support addr qualifiers.

#include <tunables/global>

profile qector-workbench /usr/lib/qector-workbench/QectorWorkbench {
  #include <abstractions/base>
  #include <abstractions/tcltk>
  #include <abstractions/fonts>
  #include <abstractions/nameservice>
  #include <abstractions/audio>

  # ---- the bundle itself: self-contained, read + exec only ---------------
  /usr/lib/qector-workbench/       r,
  /usr/lib/qector-workbench/**     r,
  /usr/lib/qector-workbench/QectorWorkbench mr,
  owner /usr/lib/qector-workbench/_internal/** r,

  # ---- per-user app data (logs, exports, licence, workspace) -------------
  owner @{HOME}/.local/share/QectorWorkbench/ r,
  owner @{HOME}/.local/share/QectorWorkbench/** rwk,
  owner @{HOME}/.qector/ r,
  owner @{HOME}/.qector/** rwk,

  # ---- desktop integration -------------------------------------------------
  owner @{HOME}/.config/** rwk,
  owner @{HOME}/.cache/** rwk,
  owner @{HOME}/Desktop/ r,
  owner @{HOME}/.Xauthority r,

  # ---- network: loopback ONLY ----------------------------------------------
  network inet  stream,        # loopback allowed (local REST API)
  network inet  stream addr 127.0.0.0/8,
  network inet6 stream addr ::1/128,
  network inet  dgram  addr 127.0.0.0/8,
  network inet6 dgram  addr ::1/128,
  network unix  stream,
  network unix  dgram,

  # ---- everything else explicitly closed ----------------------------------
  deny /proc/**/mem w,
  deny network inet  raw,
  deny network inet6 raw,
  deny network bluetooth,
  deny network netlink,
}