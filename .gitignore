# --- Python bytecode & caches ---
__pycache__/
*.py[co]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Build & packaging output ---
# Binaries (EXE, installer, portable zip) are release artifacts: they are
# published to GitHub Releases, not committed. Only the small text manifest
# and checksums under release_assets/ are tracked so downloads can be verified.
build/
dist/
*.exe
*.zip
*.egg-info/

# --- Virtual environments ---
.venv/
venv/

# --- Logs ---
logs/
*.log

# --- Coverage reports ---
coverage.xml
.coverage
htmlcov/

# --- Generated benchmark / documentation artifacts ---
benchmark_*.json
benchmark_export.json
code_doc_*.md
code_doc_*.json
code_doc_*.html
code_doc_*.tex
code_doc_*.pdf
code_doc_*.svg

# --- Temporary / smoke-test artifacts ---
.smoke_tmp/

# --- Release staging & runtime state ---
release_ready/
mcp_*.json

# --- SSH deploy keys ---
deploy_key.pub
