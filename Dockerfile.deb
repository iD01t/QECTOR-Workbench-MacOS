# Dockerfile.deb -- Build a flawless .deb package for QECTOR Decoder Workbench
# Run from repo root:
#   docker build -f Dockerfile.deb -t qector-deb .
#   docker create --name qector-deb-extract qector-deb
#   docker cp qector-deb-extract:/app/dist/. ./dist/   (copies whatever version was built)
#   docker rm qector-deb-extract
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install build tooling
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-setuptools \
    dpkg-dev \
    fakeroot \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the entire project tree
COPY . /app/

# Build the .deb package tree with proper Unix permissions
RUN python3 build_production.py --deb

# Build the actual .deb using fakeroot so permissions are recorded correctly.
# The package name is derived from version.py rather than hardcoded: a literal
# here silently went stale at 3.5.1 and would fail every release after it.
RUN cd /app/dist &&     VER="$(python3 -c 'import sys; sys.path.insert(0, "/app"); import version; print(version.WORKBENCH_VERSION)')" &&     PKG="qector-workbench_${VER}_amd64" &&     echo "Packaging ${PKG}" &&     { test -d "${PKG}" || { echo "package tree ${PKG} not found; dist/ holds:"; ls -1; exit 1; }; } &&     chmod -R 755 "${PKG}/DEBIAN" &&     chmod 755 "${PKG}/DEBIAN/postinst" &&     chmod 755 "${PKG}/usr/local/bin/qector-workbench" &&     fakeroot dpkg-deb --build --root-owner-group "${PKG}" "${PKG}.deb"

# Print result and assert the package is well formed
RUN cd /app/dist &&     VER="$(python3 -c 'import sys; sys.path.insert(0, "/app"); import version; print(version.WORKBENCH_VERSION)')" &&     PKG="qector-workbench_${VER}_amd64" &&     ls -lh "${PKG}.deb" &&     dpkg-deb -I "${PKG}.deb" &&     dpkg-deb -c "${PKG}.deb" | sed -n '1,40p'
